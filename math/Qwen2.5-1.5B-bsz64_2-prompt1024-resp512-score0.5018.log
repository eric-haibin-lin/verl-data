[36m(TaskRunner pid=24255)[0m \[ 988 = 117 + (n-1) \cdot 13 \]
[36m(TaskRunner pid=24255)[0m \[ 988 - 117 = (n-1) \cdot 13 \]
[36m(TaskRunner pid=24255)[0m \[ 871 = (n-1) \cdot 13 \]
[36m(TaskRunner pid=24255)[0m \[ n-1 = \frac{871}{13} = 67 \]
[36m(TaskRunner pid=24255)[0m \[ n = 68 \]
