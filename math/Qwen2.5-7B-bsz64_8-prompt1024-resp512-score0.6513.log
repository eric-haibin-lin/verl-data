[36m(TaskRunner pid=1898318)[0m \[
[36m(TaskRunner pid=1898318)[0m \sin A + \sin B = 2 \sin \left(\frac{A+B}{2}\right) \cos \left(\frac{A-B}{2}\right)
[36m(TaskRunner pid=1898318)[0m \]
