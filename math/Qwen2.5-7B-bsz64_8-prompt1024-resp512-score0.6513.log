[36m(TaskRunner pid=1898318)[0m 2z + 5y = 90 \\
[36m(TaskRunner pid=1898318)[0m -5x - z = 30 \\
[36m(TaskRunner pid=1898318)[0m x - 2y = 30
[36m(TaskRunner pid=1898318)[0m \end{cases}
[36m(TaskRunner pid=1898318)[0m \]
