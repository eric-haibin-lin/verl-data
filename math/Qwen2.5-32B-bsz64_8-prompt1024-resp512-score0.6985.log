[36m(TaskRunner pid=2059637)[0m \[
[36m(TaskRunner pid=2059637)[0m \left(16 \cdot 4\right)^{\frac 13} = \left(64\right)^{\frac 13}
[36m(TaskRunner pid=2059637)[0m \]
[36m(TaskRunner pid=2059637)[0m 
