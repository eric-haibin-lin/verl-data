[36m(TaskRunner pid=1536333)[0m \begin{align*}
[36m(TaskRunner pid=1536333)[0m \frac{2x+y}{3x-2y} &= \frac{2x+\frac{4}{3}x}{3x-2\left(\frac{4}{3}x\right)} \\
[36m(TaskRunner pid=1536333)[0m &= \frac{2x+\frac{4}{3}x}{3x-\frac{8}{3}x} \\
