[36m(TaskRunner pid=1536333)[0m &= \frac{\frac{10x}{3}}{\frac{x}{3}} \\
[36m(TaskRunner pid=1536333)[0m &= \frac{10x}{x} \\
[36m(TaskRunner pid=1536333)[0m &= 10.
[36m(TaskRunner pid=1536333)[0m \end{align*}
[36m(TaskRunner pid=1536333)[0m 
