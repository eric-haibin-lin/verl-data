[36m(TaskRunner pid=1536333)[0m \]
[36m(TaskRunner pid=1536333)[0m Simplifying,
[36m(TaskRunner pid=1536333)[0m \[
[36m(TaskRunner pid=1536333)[0m x + \frac{x+y}{2} = 2 \cdot \left(\frac{x+y}{2} + y\right)
[36m(TaskRunner pid=1536333)[0m \]
[36m(TaskRunner pid=1536333)[0m \[
