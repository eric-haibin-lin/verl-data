[36m(TaskRunner pid=1536333)[0m 49 + 15 &= 16k \\
[36m(TaskRunner pid=1536333)[0m 64 &= 16k \\
[36m(TaskRunner pid=1536333)[0m k &= \frac{64}{16} \\
[36m(TaskRunner pid=1536333)[0m k &= 4
[36m(TaskRunner pid=1536333)[0m \end{align*}
[36m(TaskRunner pid=1536333)[0m 
