[36m(TaskRunner pid=1536333)[0m &= \sqrt{\frac{9}{16}} \\
[36m(TaskRunner pid=1536333)[0m &= \frac{3}{4}.
[36m(TaskRunner pid=1536333)[0m \end{align*}
[36m(TaskRunner pid=1536333)[0m 
