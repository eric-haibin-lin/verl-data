[36m(TaskRunner pid=1466195)[0m \[ = \sqrt{\left(\frac{3}{4} \cos \frac{t}{4}\right)^2 + \left(-\frac{3}{4} \sin \frac{t}{4}\right)^2} \]
[36m(TaskRunner pid=1466195)[0m \[ = \sqrt{\frac{9}{16} \cos^2 \frac{t}{4} + \frac{9}{16} \sin^2 \frac{t}{4}} \]
[36m(TaskRunner pid=1466195)[0m \[ = \sqrt{\frac{9}{16} (\cos^2 \frac{t}{4} + \sin^2 \frac{t}{4})} \]
[36m(TaskRunner pid=1466195)[0m \[ = \sqrt{\frac{9}{16} \cdot 1} \]
[36m(TaskRunner pid=1466195)[0m \[ = \sqrt{\frac{9}{16}} \]
[36m(TaskRunner pid=1466195)[0m \[ = \frac{3}{4} \]
