[36m(TaskRunner pid=1466195)[0m \[ v = \sqrt{\left( \frac{3}{4} \right)^2 \cdot 1} \]
[36m(TaskRunner pid=1466195)[0m \[ v = \sqrt{\frac{9}{16}} \]
[36m(TaskRunner pid=1466195)[0m \[ v = \frac{3}{4} \]
[36m(TaskRunner pid=1466195)[0m 
