[36m(TaskRunner pid=2111625)[0m \[
[36m(TaskRunner pid=2111625)[0m d = s\sqrt{2}
[36m(TaskRunner pid=2111625)[0m \]
[36m(TaskRunner pid=2111625)[0m 
